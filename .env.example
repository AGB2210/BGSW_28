# Copy to .env and adjust. Every value has a working default for the local demo.

# Telemetry backends (OpenTelemetry Demo running in WSL)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui/api/v3
# OpenSearch gets a random host port on each start; leave empty to auto-discover it
OPENSEARCH_URL=

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
# Reasoning mode: slower (many hidden tokens) but sometimes more accurate
OLLAMA_THINK=false

# Agent behaviour
MAX_STEPS=12
MIN_CONFIDENCE=0.6

# Safety
DRY_RUN=true
KILL_SWITCH_FILE=.killswitch
